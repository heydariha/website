---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="mx-auto max-w-6xl px-5 pb-24 pt-40 sm:px-8">
    <h1 class="font-display text-5xl font-semibold tracking-tighter sm:text-7xl">Page not found</h1>
    <p class="mt-5 max-w-[48ch] text-lg text-sub">
      This address does not exist, or the article is older than the latest ten.
    </p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="rounded-full bg-accent px-6 py-3 font-medium text-accent-fg">Go to the home page</a>
      <a href="/news/" class="rounded-full border border-line bg-surface px-6 py-3 font-medium">See the weekly notes</a>
    </p>
  </div>
</Base>
