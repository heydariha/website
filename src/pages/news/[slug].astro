---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLatestNews, formatDate, isoDate, type NewsEntry } from '../../lib/news';

// Only the latest 10 entries get a page, matching the list.
export async function getStaticPaths() {
  const items = await getLatestNews();
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="mx-auto max-w-6xl px-5 pb-20 pt-32 sm:px-8 sm:pt-40">
    <a
      href="/news/"
      class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium transition-colors hover:bg-tint hover:text-accent"
    >
      <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M13 8H3M7 4L3 8l4 4" />
      </svg>
      All weekly notes
    </a>

    <header class="mt-10 max-w-[22ch] sm:max-w-3xl">
      <time datetime={isoDate(entry.data.date)} class="text-sm tabular-nums text-sub">
        {formatDate(entry.data.date)}
      </time>
      <h1 class="mt-3 font-display text-4xl font-semibold leading-[1.05] tracking-tighter sm:text-6xl">
        {entry.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-sub sm:text-xl">{entry.data.summary}</p>
    </header>

    <div
      class="prose prose-lg mt-12 max-w-[68ch] border-t border-line pt-10 prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4 prose-code:rounded-md prose-code:bg-tint prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:text-accent prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-2xl prose-pre:border prose-pre:border-line prose-pre:[&_code]:bg-transparent prose-pre:[&_code]:p-0 prose-pre:[&_code]:text-inherit prose-img:rounded-2xl"
    >
      <Content />
    </div>
  </article>
</Base>
