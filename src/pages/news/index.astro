---
import Base from '../../layouts/Base.astro';
import NewsList from '../../components/NewsList.astro';
import { getLatestNews, NEWS_LIMIT } from '../../lib/news';

const items = await getLatestNews(NEWS_LIMIT);
---

<Base title="Weekly notes" description="Weekly notes on engineering and AI by Hadi Heydari. The latest ten entries.">
  <div class="mx-auto max-w-6xl px-5 pb-20 pt-32 sm:px-8 sm:pt-40">
    <h1 class="font-display text-5xl font-semibold tracking-tighter sm:text-7xl">Weekly notes</h1>
    <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-sub sm:text-xl">
      Short updates on engineering and AI. Open an entry for its summary, or read the full article.
    </p>
    <div class="mt-12">
      <NewsList items={items} />
    </div>
  </div>
</Base>
