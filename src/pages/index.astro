---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { profile } from '../data/profile';
import { getLatestNews, formatDate, isoDate } from '../lib/news';

const latest = await getLatestNews(3);
const featured = latest[0];
const links = profile.links.filter((l) => l.href);
const headline = ['Kotlin', 'Spring Boot', 'PostgreSQL', 'AWS', 'Docker', 'Terraform'];
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="dot-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-6xl gap-12 px-5 pb-20 pt-32 sm:px-8 sm:pt-40 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <p class="inline-flex rounded-full bg-tint px-4 py-1.5 text-sm font-medium text-accent">
          {profile.role}
        </p>
        <h1 class="mt-6 font-display text-6xl font-semibold leading-[0.95] tracking-tighter sm:text-8xl">
          Hadi<br />Heydari
        </h1>
        <p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-sub sm:text-xl">{profile.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="rounded-full bg-accent px-6 py-3 font-medium text-accent-fg transition-opacity hover:opacity-90"
          >
            Get in touch
          </a>
          <a
            href="/news/"
            class="rounded-full border border-line bg-surface px-6 py-3 font-medium transition-colors hover:bg-tint hover:text-accent"
          >
            Read the weekly notes
          </a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-2" aria-label="Main technologies">
          {
            headline.map((t) => (
              <li class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm text-sub">{t}</li>
            ))
          }
        </ul>
      </div>

      {
        featured && (
          <a
            href={`/news/${featured.id}/`}
            class="group block rounded-3xl border border-line bg-surface p-7 transition-colors hover:border-accent"
          >
            <p class="text-sm font-medium text-accent">Latest note</p>
            <time datetime={isoDate(featured.data.date)} class="mt-1 block text-sm text-sub">
              {formatDate(featured.data.date)}
            </time>
            <h2 class="mt-5 font-display text-2xl font-semibold leading-snug tracking-tight">
              {featured.data.title}
            </h2>
            <p class="mt-3 leading-relaxed text-sub">{featured.data.summary}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-medium text-accent">
              Read article
              <svg class="size-4 transition-transform motion-reduce:transition-none group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <!-- About -->
    <section id="about" class="py-20">
      <h2 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">About</h2>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1.2fr_1fr]">
        <div class="space-y-5 text-lg leading-relaxed sm:text-xl">
          {profile.about.map((p, i) => <p class={i === 0 ? '' : 'text-sub'}>{p}</p>)}
        </div>
        <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-1">
          {
            profile.skills.map((s) => (
              <div class="border-t border-line pt-4">
                <dt class="font-display text-lg font-semibold tracking-tight">{s.group}</dt>
                <dd class="mt-2 flex flex-wrap gap-1.5">
                  {s.items.map((i) => (
                    <span class="rounded-full bg-tint px-3 py-1 text-sm text-accent">{i}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-20">
      <h2 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Experience</h2>
      <ol class="mt-10">
        {
          profile.experience.map((job) => (
            <li class="grid gap-3 border-t border-line py-8 md:grid-cols-[13rem_1fr] md:gap-10">
              <p class="text-sm tabular-nums text-sub md:pt-2">{job.period}</p>
              <div>
                <h3 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">{job.role}</h3>
                <p class="mt-1 font-medium text-accent">
                  {job.company}
                  <span class="font-normal text-sub">, {job.place}</span>
                </p>
                <ul class="mt-4 max-w-[64ch] list-disc space-y-2 pl-5 leading-relaxed text-sub marker:text-accent">
                  {job.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 grid gap-10 border-t border-line pt-10 sm:grid-cols-2">
        <div>
          <h3 class="font-display text-2xl font-semibold tracking-tight">Education</h3>
          <ul class="mt-5 space-y-5">
            {
              profile.education.map((e) => (
                <li>
                  <p class="font-medium">{e.title}</p>
                  <p class="text-sub">{e.place}, {e.period}</p>
                  {e.note && <p class="mt-1 text-sm text-sub">{e.note}</p>}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="font-display text-2xl font-semibold tracking-tight">Certificates</h3>
          <ul class="mt-5 space-y-5">
            {
              profile.certificates.map((c) => (
                <li>
                  <p class="font-medium">{c.title}</p>
                  <p class="text-sub">{c.issuer}, {c.date}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- News -->
    <section id="news" class="py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">Weekly notes</h2>
        <a href="/news/" class="font-medium text-accent underline underline-offset-4">See all recent notes</a>
      </div>
      <div class="mt-8">
        <NewsList items={latest} />
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="pb-20 pt-10">
      <div class="rounded-[2rem] bg-accent p-8 text-accent-fg sm:p-14">
        <h2 class="font-display text-4xl font-semibold tracking-tight sm:text-6xl">Let’s talk.</h2>
        <p class="mt-4 max-w-[48ch] text-lg opacity-90">
          Backend engineering, team leadership, or the topics in the weekly notes: I am happy to chat.
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-8 inline-block break-all font-display text-2xl font-semibold underline decoration-2 underline-offset-8 sm:text-4xl"
        >
          {profile.email}
        </a>
        <ul class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel="me noopener"
                  target="_blank"
                  class="inline-block rounded-full border border-current px-4 py-2 transition-opacity hover:opacity-80"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
          <li class="inline-block rounded-full px-4 py-2 opacity-90">{profile.location}</li>
        </ul>
      </div>
    </section>
  </div>
</Base>
