---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-6xl px-5 pb-10 pt-6 sm:px-8">
  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line pt-6 text-sm text-sub">
    <p>&copy; {year} {profile.name}</p>
    <p>Built with Astro and Tailwind CSS</p>
  </div>
</footer>
