---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/news/', label: 'News' },
  { href: '/#contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-3 z-40 flex justify-center px-3 sm:top-5">
  <nav
    aria-label="Main"
    class="flex items-center gap-1 rounded-full border border-line bg-surface/80 p-1.5 shadow-sm backdrop-blur-xl"
  >
    <a
      href="/"
      aria-label="Home"
      class="mr-1 hidden size-9 place-items-center rounded-full bg-fg font-display text-sm font-semibold text-bg sm:grid"
    >
      HH
    </a>
    <ul class="flex items-center gap-0.5 text-sm font-medium">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={l.href === '/news/' && path.startsWith('/news') ? 'page' : undefined}
              class="block rounded-full px-3 py-2 text-sub transition-colors hover:bg-tint hover:text-accent aria-[current=page]:bg-tint aria-[current=page]:text-accent sm:px-4"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
